# Токен модератора от @BotFather. Сначала тестовый бот и тестовая группа
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько через запятую. Владелец только по ID
OWNER_IDS=

# ---------- Внутренний API между ботами (только 127.0.0.1, снаружи его нет) ----------
GUARD_API_PORT=8711
BAXI_API_URL=http://127.0.0.1:8710
# Общий ключ, одинаковый в .env Бакси и модератора. Пусто: API модератора не запускается, события не шлются
BAXI_API_KEY=
# Ключ для будущей веб-админки (API /v1/admin/ на том же порту). Пусто: веб-API выключен.
# Сгенерировать: openssl rand -hex 24
WEB_API_KEY=
# 1: работать только в чатах, где Бакси оплачен или на пробном (или своя подписка в /admin). 0: во всех
GUARD_NEEDS_BAXI_PAID=0
# ID бота Бакси: если он в чате, на голую /settings отвечает Бакси, а модератор только на /settings@имя_модератора
BAXI_BOT_ID=

# ---------- Нейросеть для спорных случаев антиспама (по умолчанию выключена) ----------
# Пусто: нейросети нет. Включается ещё и в настройках каждого чата
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Сколько запросов в сутки на все чаты
AI_DAILY_LIMIT=100

TZ_NAME=Asia/Almaty
DATA_DIR=data
LOG_LEVEL=INFO
